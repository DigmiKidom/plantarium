{
  "name": "plantarium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run db:test && node scripts/species-migration.mjs --check",
    "db:check": "node --env-file=.env.local scripts/check-db.mjs",
    "db:drift": "node --env-file=.env.local scripts/check-drift.mjs",
    "r2:check": "node --env-file=.env.local scripts/check-r2.mjs",
    "db:test": "node scripts/test-db.mjs",
    "db:species": "node scripts/species-migration.mjs",
    "db:link": "supabase link --project-ref vnlobcdmswymtzesjdwk",
    "db:status": "supabase migration list",
    "db:new": "supabase migration new",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@fontsource-variable/heebo": "^5.3.0",
    "@sentry/nextjs": "^11.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-youtube": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/static-renderer": "^3.31.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
