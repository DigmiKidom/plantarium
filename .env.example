# Copy to .env.local. Without these the site runs on the local seed (src/data/species.json).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (scripts, jobs). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare R2 (photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=plantarium-media
NEXT_PUBLIC_IMAGES_URL=

# Optional: Cloudflare Turnstile ("I am human" check on login/signup/reset). Both needed to turn it on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
